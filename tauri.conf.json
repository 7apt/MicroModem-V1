{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicroModem",
  "version": "0.1.0",
  "identifier": "io.micromodem.detector",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MicroModem",
        "width": 920,
        "height": 680,
        "minWidth": 620,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
