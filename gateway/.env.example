# Android-facing SOCKS5 endpoint discovered by `micromodem scan`.
SOCKS5_ADDR=192.168.49.1
SOCKS5_PORT=8228

# Interface connected to a router WAN port, or the Wi-Fi adapter used as an AP.
DOWNSTREAM_IF=enp3s0
DOWNSTREAM_MODE=ethernet
DOWNSTREAM_ADDR=10.77.0.1/24
DOWNSTREAM_SUBNET=10.77.0.0/24
TUN_MTU=1400
CLIENT_MTU=1400
DHCP_START=10.77.0.20
DHCP_END=10.77.0.200
DHCP_LEASE=12h
DNS_SERVERS=1.1.1.1,9.9.9.9

# Used only when DOWNSTREAM_MODE=wifi. The adapter must support AP mode.
WIFI_SSID=MicroModem
WIFI_PASSPHRASE=change-this-password
WIFI_CHANNEL=6
WIFI_COUNTRY=US

# SOCKS5 options.
SOCKS5_UDP_MODE=udp
SOCKS5_USERNAME=
SOCKS5_PASSWORD=
LOG_LEVEL=info
